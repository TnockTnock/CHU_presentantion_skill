{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Renderer-independent CGU Content Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "cgu-content/1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "claim_type",
          "value",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "appendix_candidate",
              "assumption",
              "categories",
              "chart_series",
              "claim",
              "fact",
              "interpretation",
              "kpi",
              "node",
              "quotation",
              "relationship",
              "speaker_note"
            ]
          },
          "claim_type": {
            "enum": [
              "assumption",
              "fact",
              "interpretation",
              "quotation",
              "source_report"
            ]
          },
          "value": {},
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "kpi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit",
              "currency",
              "sign",
              "period",
              "comparison_base"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "sign": {
                "type": "string"
              },
              "period": {
                "type": "string"
              },
              "comparison_base": {
                "type": "string"
              }
            }
          },
          "source_components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit",
              "currency",
              "sign",
              "period",
              "comparison_base"
            ],
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "pointer"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "unit": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "pointer"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "currency": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "pointer"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "sign": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "pointer"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "period": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "pointer"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "comparison_base": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "pointer"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "pointer",
                "value"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}
